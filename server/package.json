{
  "name": "workflow-orchestration-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include \"src/**/*\" scripts/start-service.mjs --dev",
    "dev:api": "tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "dev:worker": "tsx src/temporal/worker.ts",
    "start": "node scripts/start-service.mjs",
    "start:api": "node dist/index.js",
    "start:worker": "node dist/temporal/worker.js",
    "engine:publish": "node scripts/publish-engine.mjs",
    "engine:start": "node scripts/start-engine.mjs",
    "history:export": "node scripts/export-history.mjs",
    "history:replay": "node scripts/replay-history.mjs"
  },
  "dependencies": {
    "@temporalio/activity": "1.25.0",
    "@temporalio/client": "1.25.0",
    "@temporalio/common": "1.25.0",
    "@temporalio/worker": "1.25.0",
    "@temporalio/workflow": "1.25.0",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "express": "^4.19.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@temporalio/testing": "1.25.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=20.3.0"
  }
}
